<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .hero-section {
            background: linear-gradient(rgba(7, 7, 7, 0.6), rgba(7, 7, 7, 0.95)), url('https://images.unsplash.com/photo-1618220179428-22790b46a0eb?q=80&w=1920&auto=format&fit=crop') no-repeat center center/cover;
            height: 75vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            position: relative;
        }
        .hero-section::after {
            content: '';
            position: absolute;
            bottom: 0; left: 0; right: 0; height: 150px;
            background: linear-gradient(to bottom, transparent, var(--bg-dark));
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top" style="background: rgba(7,7,7,0.7); backdrop-filter: blur(20px); border-bottom: 1px solid rgba(255,255,255,0.05);">
        <div class="container py-2">
            <a class="navbar-brand" href="/">
                <i class="fas fa-couch me-2" style="color: var(--primary-color);"></i>FurnShop
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="topNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link active" href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#products">Collection</a>
                    </li>
                </ul>
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center">
                    <% if (user) { %>
                        <li class="nav-item">
                            <a class="nav-link btn btn-outline-primary btn-sm me-2 px-3" href="/dashboard" style="color: var(--primary-color);">Admin Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-danger" href="/auth/logout">Logout</a>
                        </li>
                    <% } else { %>
                        <li class="nav-item">
                            <a class="nav-link btn btn-primary btn-sm ms-2 px-3 text-dark" href="/auth/login">Login</a>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero-section">
        <div class="container position-relative animate-fade-up" style="z-index: 2;">
            <h1 class="display-3 text-white mb-3" style="font-weight: 700; letter-spacing: -1px;">Crafted for <span style="color: var(--primary-color);">Elegance</span></h1>
            <p class="lead text-light mb-5" style="max-width: 600px; margin: 0 auto; color: var(--text-muted)!important; font-size: 1.1rem;">Elevate your living space with our premium collection of modern, meticulously designed luxury furniture.</p>
            <a href="#products" class="btn btn-primary btn-lg px-5 rounded-pill shadow-lg">Explore Collection</a>
        </div>
    </section>

    <!-- Products Section -->
    <section id="products" class="py-5">
        <div class="container pt-5">
            <div class="text-center mb-5 animate-fade-up">
                <span class="text-uppercase" style="color: var(--primary-color); font-weight: 600; letter-spacing: 2px; font-size: 0.85rem;">Curated Pieces</span>
                <h2 class="display-5 mt-2 mb-0">Our Exclusive Collection</h2>
            </div>
            
            <div class="row g-5">
                <% if (products && products.length > 0) { %>
                    <% products.forEach((product, index) => { %>
                        <div class="col-md-4 col-sm-6">
                            <div class="product-card animate-fade-up" style="animation-delay: <%= index * 0.1 %>s">
                                <div class="product-img-wrapper">
                                    <img src="<%= product.image %>" alt="<%= product.name %>">
                                </div>
                                <div class="p-4">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <span class="badge" style="background-color: rgba(212, 175, 55, 0.15); color: var(--primary-color); border: 1px solid rgba(212,175,55,0.3); font-size: 0.75rem; padding: 6px 10px;">
                                            <%= product.category ? product.category.name : 'Premium' %>
                                        </span>
                                        <h5 class="m-0" style="color: var(--text-main); font-weight: 600;">$<%= product.price.toLocaleString() %></h5>
                                    </div>
                                    <h4 class="mb-2 fs-5"><%= product.name %></h4>
                                    <p class="text-muted small mb-4" style="line-height: 1.6;"><%= product.description.substring(0, 80) %>...</p>
                                    <a href="/product-details/<%= product._id %>" class="btn btn-outline-light w-100 rounded-pill">View Details</a>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="col-12 text-center text-muted">
                        <h4>No products available at the moment.</h4>
                        <p>Please check back later!</p>
                    </div>
                <% } %>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="py-4 border-top text-center" style="background-color: var(--bg-card); border-color: var(--border-color)!important;">
        <div class="container">
            <h4 style="color: var(--primary-color); font-weight: 700;"><i class="fas fa-couch me-2"></i>FurnShop</h4>
            <p class="text-muted small mb-0">&copy; 2026 FurnShop Furniture. All rights reserved.</p>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
