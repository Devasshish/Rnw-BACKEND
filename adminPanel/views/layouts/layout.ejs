<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FurnShop | <%= typeof title != 'undefined' ? title : 'Admin Panel' %></title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <div class="layout-wrapper" style="min-height: 100vh; overflow-x: hidden; width: 100%;">
        <!-- Sidebar -->
        <div class="sidebar position-fixed d-none d-md-block" style="z-index: 1030;">
            <%- include('../partials/sidebar') %>
        </div>
        
        <!-- Main Content -->
        <div class="main-content flex-grow-1 d-flex flex-column" style="min-width: 0;">
            <%- include('../partials/header') %>
            
            <main class="flex-grow-1 py-5">
                <div class="container">
                    <%- include('../partials/messages') %>
                    <%- body %>
                </div>
            </main>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function() {
            // Cascading dropdown logic
            $('#categorySelect').change(function() {
                const catId = $(this).val();
                if(catId) {
                    $.get('/subcategory/by-category/' + catId, function(data) {
                        $('#subcategorySelect').empty().append('<option value="">Select Subcategory</option>');
                        data.forEach(function(sub) {
                            $('#subcategorySelect').append(`<option value="${sub._id}">${sub.name}</option>`);
                        });
                        $('#extraCategorySelect').empty().append('<option value="">Select Extra Category</option>');
                    });
                } else {
                    $('#subcategorySelect').empty().append('<option value="">Select Subcategory</option>');
                    $('#extraCategorySelect').empty().append('<option value="">Select Extra Category</option>');
                }
            });

            $('#subcategorySelect').change(function() {
                const subId = $(this).val();
                if(subId) {
                    $.get('/extracategory/by-subcategory/' + subId, function(data) {
                        $('#extraCategorySelect').empty().append('<option value="">Select Extra Category</option>');
                        data.forEach(function(extra) {
                            $('#extraCategorySelect').append(`<option value="${extra._id}">${extra.name}</option>`);
                        });
                    });
                } else {
                    $('#extraCategorySelect').empty().append('<option value="">Select Extra Category</option>');
                }
            });
        });
    </script>
</body>
</html>
