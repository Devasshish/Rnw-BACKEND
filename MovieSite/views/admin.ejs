<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Film Zone - Admin Dashboard</title>
    <link rel="stylesheet" href="/css/output.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-black text-white" style="padding: 20px 50px;" >
    <!-- Navigation Bar -->
    <nav class="flex justify-between items-center px-16 py-6 text-white border-b border-red-500">
        <div>
            <h1 class="text-5xl font-bold">FILM<span class="text-red-500">|</span>ZONE</h1>
        </div>
        <div class="flex gap-8 items-center">
            <a href="/" class="hover:text-red-500 transition font-semibold">Home</a>
            <a href="/add" class="bg-red-500 hover:bg-red-600 text-white font-bold py-2 px-6 rounded transition" style="padding: 10px;">
                <i class="fas fa-plus"></i> Add Movie
            </a>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="pl-16 pr-16 py-12" style="margin-top: 50px;">
        <h2 class="text-4xl">Admin Dashboard</h2>
        <!-- Stats Section -->
        <div class="flex  gap-10 mb-12" style="margin-top: 20px;">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-gray-400 text-sm font-semibold mb-2">Total Movies</p>
                        <p class="text-5xl font-bold text-white"><%= movies.length %></p>
                    </div>
                </div>

                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-gray-400 text-sm font-semibold mb-2">Featured</p>
                        <p class="text-5xl font-bold text-yellow-400"><%= movies.filter(m => m.featured).length %></p>
                    </div>
                </div>
        </div>

        <!-- Search Bar -->
        <div class="mb-8 flex gap-4 items-center" style="margin-top: 20px;">
            <input type="text" id="searchInput" class="flex-1 bg-gray-900 border border-gray-700 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:border-red-500 focus:outline-none transition"
                   placeholder="Search movies by name...">
            <button class="bg-red-500 hover:bg-red-600 text-white font-bold py-3 px-6 rounded transition" onclick="filterMovies('all')" style="padding: 10px;">
                <i class="fas fa-list"></i> All
            </button>
            <button class="bg-gray-800 hover:bg-gray-700 border text-white font-bold py-3 px-6 rounded transition" onclick="filterMovies('featured')" style="padding: 10px;">
                <i class="fas fa-star"></i> Featured
            </button>
        </div>

        <!-- Movies Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-6" id="moviesGrid">
            <% movies.forEach((movie, index) => { %>
                <div class="movie-card" data-movie-name="<%= movie.movieName.toLowerCase() %>" data-featured="<%= movie.featured %>" data-trending="<%= movie.isTrending %>" style="border: 2px solid white; border-radius: 10px; padding: 10px;">
                    <div class="relative group overflow-hidden rounded-lg" style="width: 100%; height: 350px;">
                        <img class="w-full h-full object-cover group-hover:scale-110 transition duration-300 cursor-pointer" 
                             src="../uploads/<%= movie.posterURI %>" 
                             alt="<%= movie.movieName %>">
                        
                        <!-- Overlay with buttons -->
                        <div class="absolute inset-0 bg-black/70 opacity-0 group-hover:opacity-100 transition duration-300 flex items-center justify-center gap-3">
                            <a href="/edit/<%= movie._id %>" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded transition flex items-center gap-2">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                            <form method="POST" action="/delete/<%= movie._id %>" style="display:inline;" onsubmit="return confirm('Are you sure?')">
                                <button type="submit" class="bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded transition flex items-center gap-2">
                                    <i class="fas fa-trash"></i> Delete
                                </button>
                            </form>
                        </div>
                    </div>

                    <!-- Movie Info -->
                    <div class="mt-10" style="display: flex; flex-direction: column; gap: 10px; margin-top: 15px;">
                        <h3 class="text-white flex justify-center font-bold text-xl truncate mb-1"><%= movie.movieName %></h3>
                        <!-- <div class="flex gap-2 mt-2">
                            <a href="/edit/<%= movie._id %>" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-1 px-2 rounded text-center text-xs transition">
                                Edit
                            </a>
                            <form method="POST" action="/delete/<%= movie._id %>" style="display:block; flex: 1;" onsubmit="return confirm('Delete this movie?')">
                                <button type="submit" class="w-full bg-red-600 hover:bg-red-700 text-white font-semibold py-1 px-2 rounded text-xs transition">
                                    Delete
                                </button>
                            </form>
                        </div> -->
                    </div>
                </div>
            <% }); %>
        </div>

        <!-- Empty State -->
        <% if(movies.length === 0) { %>
            <div class="text-center py-20">
                <i class="fas fa-inbox text-6xl text-gray-600 mb-6"></i>
                <h3 class="text-3xl font-bold text-gray-400 mb-3">No Movies Found</h3>
                <p class="text-gray-500 mb-8">Start by adding your first movie to the collection</p>
                <a href="/add" class="bg-red-500 hover:bg-red-600 text-white font-bold py-3 px-8 rounded transition inline-flex items-center gap-2">
                    <i class="fas fa-plus"></i> Add Your First Movie
                </a>
            </div>
        <% } %>
    </div>

    <script>
        let currentFilter = 'all';

        function filterMovies(filter) {
            currentFilter = filter;
            const cards = document.querySelectorAll('.movie-card');
            
            cards.forEach(card => {
                let show = false;
                
                if (filter === 'all') {
                    show = true;
                } else if (filter === 'featured' && card.dataset.featured === 'true') {
                    show = true;
                } else if (filter === 'trending' && card.dataset.trending === 'true') {
                    show = true;
                }
                
                card.style.display = show ? '' : 'none';
            });
        }

        // Search functionality
        document.getElementById('searchInput').addEventListener('input', (e) => {
            const searchTerm = e.target.value.toLowerCase();
            const cards = document.querySelectorAll('.movie-card');
            
            cards.forEach(card => {
                const movieName = card.dataset.movieName;
                const matches = movieName.includes(searchTerm);
                
                if (currentFilter === 'all') {
                    card.style.display = matches ? '' : 'none';
                } else if (currentFilter === 'featured') {
                    card.style.display = (matches && card.dataset.featured === 'true') ? '' : 'none';
                } else if (currentFilter === 'trending') {
                    card.style.display = (matches && card.dataset.trending === 'true') ? '' : 'none';
                }
            });
        });
    </script>
</body>
</html>