<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= movie.movieName %> - Trailer</title>
    <link rel="stylesheet" href="/css/output.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #000000;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 20px;
            font-family: Arial, sans-serif;
        }

        .outer-container {
            width: 100%;
            max-width: 1400px;
            border: 3px solid #d4453a;
            border-radius: 30px;
            padding: 40px;
            aspect-ratio: 16 / 9;
            position: relative;
            background: #000;
        }

        .close-btn {
            position: absolute;
            top: 30px;
            right: 50px;
            background: transparent;
            border: 2px solid #d4453a;
            color: white;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            font-size: 28px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
            z-index: 100;
        }

        .close-btn:hover {
            background: #d4453a;
            color: #000;
            transform: scale(1.1);
        }

        .inner-container {
            width: 100%;
            height: 100%;
            border: 3px solid #d4453a;
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #000;
            overflow: hidden;
        }

        .video-container {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        iframe {
            width: 100%;
            height: 100%;
            border: none;
        }

        .placeholder {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            width: 100%;
            height: 100%;
            color: #00ff00;
            font-size: 32px;
            text-align: center;
        }

        .play-icon {
            font-size: 80px;
            margin-bottom: 20px;
            opacity: 0.7;
        }

        video {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        @media (max-width: 768px) {
            .outer-container {
                padding: 20px;
                aspect-ratio: auto;
                min-height: 300px;
            }

            .close-btn {
                width: 40px;
                height: 40px;
                font-size: 24px;
            }

            .placeholder {
                font-size: 24px;
            }

            .play-icon {
                font-size: 60px;
            }
        }
    </style>
</head>

<body>
    <!-- CLOSE BUTTON -->
    <a href="/detailed/<%= movie._id %>">
        <button class="close-btn">×</button>
    </a>

    <div class="outer-container">
            <div class="video-container">
                <% if(movie.trailerURI && movie.trailerURI.includes('youtube.com') || movie.trailerURI.includes('youtu.be')) { %>
                    <!-- YOUTUBE VIDEO -->
                    <iframe 
                        src="<%= movie.trailerURI.includes('youtube.com/watch?v=') ? 'https://www.youtube.com/embed/' + movie.trailerURI.split('v=')[1] : 'https://www.youtube.com/embed/' + movie.trailerURI.split('/').pop() %>"
                        allowfullscreen="" 
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        referrerpolicy="no-referrer-when-downgrade">
                    </iframe>
                
                <% } else { %>
                    <!-- PLACEHOLDER -->
                    <div class="placeholder">
                        <div class="play-icon">▶</div>
                        <div>YouTube video</div>
                    </div>
                <% } %>
            </div>
    </div>

</body>

</html>