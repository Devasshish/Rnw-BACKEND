<!DOCTYPE html>
<html lang="en">
<head>
  <title>My Articles | BlogCenter</title>
  <%- include('head') %>
</head>
<body>
  <%- include('navbar', { user: user }) %>
  
  <main class="max-w-7xl mx-auto my-20 px-6 w-full flex-1">
    <div class="text-center mb-20 fade-up">
      <h1 class="page-title text-5xl md:text-7xl font-black tracking-tighter mb-6 bg-gradient-to-br from-white via-slate-300 to-slate-600 bg-clip-text text-transparent inline-block">
        My Articles.
      </h1>
      <p class="text-xl text-slate-400 font-light max-w-2xl mx-auto">Manage and view the stories you've shared with the world.</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 xl:gap-12">
      <% if (articles.length > 0) { %>
        <% articles.forEach(article => { %>
          <div class="glass-card stagger-item flex flex-col h-full group">
            <h2 class="text-3xl font-bold text-white mb-3 line-clamp-2 group-hover:text-primary transition-colors duration-300">
              <a href="/articles/<%= article._id %>" class="absolute inset-0 z-10"><span class="sr-only">Read <%= article.title %></span></a>
              <%= article.title %>
            </h2>
            <p class="text-sm text-slate-400 mb-6 font-medium tracking-wide">
              Published on <%= article.createdAt.toDateString() %>
            </p>
            <p class="text-slate-400 flex-grow mb-8 line-clamp-3 leading-relaxed font-light">
              <%= article.content.substring(0, 150) %>...
            </p>
            <div class="mt-auto flex items-center text-primary font-bold tracking-widest text-sm uppercase group-hover:translate-x-2 transition-transform duration-300">
              View Article <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-span-full text-center text-slate-500 py-20 fade-up border border-white/5 rounded-3xl bg-white/[0.01]">
          <p class="text-2xl font-light">You haven't written any articles yet.</p>
          <a href="/articles/new" class="inline-block mt-6 btn-primary">Start writing now</a>
        </div>
      <% } %>
    </div>
  </main>

  <%- include('scripts') %>
</body>
</html>
