<!DOCTYPE html>
<html lang="en">
  <!-- login page -->
<head>
  <title>Login | BlogCenter</title>
  <%- include('head') %>
</head>
<body class="flex flex-col items-center justify-center min-h-screen relative overflow-hidden">
  <!-- Abstract Background Elements -->
  <div class="absolute top-[-20%] left-[-10%] w-[50%] h-[50%] bg-primary/20 blur-[120px] rounded-full pointer-events-none"></div>
  <div class="absolute bottom-[-20%] right-[-10%] w-[50%] h-[50%] bg-accent/20 blur-[120px] rounded-full pointer-events-none"></div>

  <div class="absolute top-0 w-full z-50">
    <%- include('navbar', { user: user }) %>
  </div>
  
  <main class="w-full max-w-md px-6 mt-32 relative z-10">
    <div class="glass-card fade-up !p-10">
      <h1 class="page-title text-4xl font-black text-center mb-3 text-white tracking-tight">Welcome Back.</h1>
      <p class="text-center text-slate-400 mb-10 font-light">Sign in to continue your journey.</p>
      
      <% if (typeof error !== 'undefined') { %>
        <div class="bg-red-500/10 border border-red-500/50 text-red-400 px-4 py-3 rounded-xl mb-8 text-center text-sm font-medium fade-up">
          <%= error %>
        </div>
      <% } %>

      <form action="/login" method="POST">
        <div class="mb-6 fade-up" style="transition-delay: 0.1s">
          <label for="username" class="block text-xs uppercase tracking-widest font-bold mb-2 text-slate-400">Username</label>
          <input type="text" id="username" name="username" class="form-input" required placeholder="Enter your username">
        </div>
        
        <div class="mb-10 fade-up" style="transition-delay: 0.2s">
          <label for="password" class="block text-xs uppercase tracking-widest font-bold mb-2 text-slate-400">Password</label>
          <input type="password" id="password" name="password" class="form-input" required placeholder="Enter your password">
        </div>
        
        <div class="fade-up" style="transition-delay: 0.3s">
          <button type="submit" class="btn-primary w-full text-lg py-4">Sign In</button>
        </div>
      </form>
      
      <p class="text-center mt-8 text-slate-500 fade-up" style="transition-delay: 0.4s">
        Don't have an account? <a href="/register" class="text-white font-medium hover:text-primary transition-colors">Create one</a>
      </p>
    </div>
  </main>

  <%- include('scripts') %>
</body>
</html>
