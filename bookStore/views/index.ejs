<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Store Collection</title>
    <link rel="stylesheet" href="/style.css">
    <!-- Load Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800;900&display=swap" rel="stylesheet">
    <style>
        
        body {
            font-family: 'Outfit', sans-serif;
        }

        /* Animated Background Gradients */
        .bg-blob {
            position: absolute;
            filter: blur(100px);
            z-index: -1;
            opacity: 0.6;
            animation: float 10s infinite ease-in-out alternate;
        }

        @keyframes float {
            0% {
                transform: translate(0, 0) scale(1);
            }

            100% {
                transform: translate(30px, -50px) scale(1.2);
            }
        }
    </style>
</head>

<body
    class="min-h-screen bg-black text-white overflow-x-hidden selection:bg-cyan-500 selection:text-black relative z-0">

    <!-- Background Blobs -->
    <div class="bg-blob w-[500px] h-[500px] bg-purple-600 rounded-full top-[-100px] left-[-100px]"></div>
    <div class="bg-blob w-[400px] h-[400px] bg-pink-600 rounded-full bottom-[10%] right-[-50px] animation-delay-2000">
    </div>
    <div
        class="bg-blob w-[600px] h-[600px] bg-blue-600 rounded-full top-[30%] left-[30%] opacity-30 animation-delay-4000">
    </div>

    <!-- Navbar / Header -->
    <header class="w-full bg-black/30 backdrop-blur-2xl border-b border-white/10 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-6 py-5 flex items-center justify-between">
            <h1
                class="text-4xl font-black tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-fuchsia-500 to-purple-500 drop-shadow-[0_0_15px_rgba(236,72,153,0.5)]">
                NEXA<span class="text-white">BOOKS</span>
            </h1>
            <a href="add"
                class="group relative px-8 py-3 font-bold text-white rounded-full bg-white/5 border border-white/20 overflow-hidden transition-all hover:scale-105 hover:border-cyan-400 hover:shadow-[0_0_20px_rgba(34,211,238,0.4)]">
                <div
                    class="absolute inset-0 bg-gradient-to-r from-cyan-500 to-purple-600 opacity-0 group-hover:opacity-100 transition-opacity duration-300 -z-10">
                </div>
                + ADD DROP
            </a>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-6 py-16 relative z-10">
        <div class="mb-16 text-center">
            <h2 class="text-6xl font-black mb-4 uppercase tracking-tight">The <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-pink-500 to-orange-400">Collection</span>
            </h2>
            <p class="text-xl text-gray-400 font-light tracking-wide">Explore your digital library matrix.</p>
        </div>

        <% if (books.length===0) { %>
            <div
                class="w-full max-w-2xl mx-auto flex flex-col items-center justify-center py-24 bg-white/5 border border-white/10 rounded-3xl backdrop-blur-xl shadow-2xl">
                <div class="text-7xl mb-6 drop-shadow-[0_0_15px_rgba(255,255,255,0.5)]">🛸</div>
                <h3 class="text-3xl font-bold mb-3 text-white">The Void is Empty</h3>
                <p class="text-gray-400 mb-8 text-lg">No artifacts found in this sector.</p>
                <a href="add"
                    class="px-8 py-3 rounded-full bg-gradient-to-r from-pink-500 to-purple-600 text-white font-bold tracking-wider hover:shadow-[0_0_30px_rgba(236,72,153,0.6)] hover:scale-110 transition-all duration-300">Summon
                    Book</a>
            </div>
            <% } else { %>
                <div class="flex flex-wrap justify-start gap-8 lg:gap-12 items-start "
                    style="gap: 50px; display: flex; flex-wrap: wrap; justify-content: center;">
                    <% books.forEach((book)=> { %>
                        <div
                            class="group relative bg-white/10 backdrop-blur-xl border border-white/20 rounded-[2rem] overflow-hidden hover:-translate-y-4 hover:shadow-[0_0_40px_rgba(236,72,153,0.3)] transition-all duration-500 flex flex-col w-[400px]">

                            <!-- Glowing border effect on hover -->
                            <div
                                class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-pink-500/20 opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-0">
                            </div>

                            <!-- Image Container -->
                            <div class="w-full aspect-[3/4] p-4 relative z-10 flex-shrink-0" style="height: 450px;">
                                <div class="w-full h-full rounded-2xl overflow-hidden relative shadow-2xl"
                                    style="height: 400px;">
                                    <!-- Overlay gradient -->
                                    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent z-10 opacity-60 group-hover:opacity-20 transition-opacity duration-300"
                                        style="height: 400px;"></div>

                                    <img src="../uploads/<%= book.img %>" alt="<%= book.name %>"
                                        class="w-full h-[500px] object-cover group-hover:scale-110 transition-transform duration-700 ease-out">

                                    <!-- Category Badge -->
                                    <div class="absolute top-3 left-3 z-20">
                                        <span
                                            class="px-3 py-1.5 text-[10px] font-black uppercase tracking-widest bg-cyan-400 text-black rounded-full shadow-[0_0_15px_rgba(34,211,238,0.6)]">
                                            <%= book.category %>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <!-- Card Content -->
                            <div class="px-6 pb-6 pt-4 flex flex-col flex-grow relative z-20 space-y-3">
                                <div class="flex items-center justify-between">
                                    <span class="text-xs text-gray-400 uppercase tracking-widest font-bold">Book
                                        Name:</span>
                                    <p
                                        class="text-sm font-black text-white line-clamp-1 group-hover:text-cyan-300 transition-colors">
                                        <%= book.name %>
                                    </p>
                                </div>

                                <div class="flex items-center justify-between">
                                    <span
                                        class="text-xs text-gray-400 uppercase tracking-widest font-bold">Author:</span>
                                    <p class="text-sm font-bold text-pink-400 truncate">
                                        <%= book.author %>
                                    </p>
                                </div>

                                <div class="flex items-center justify-between">
                                    <span
                                        class="text-xs text-gray-400 uppercase tracking-widest font-bold">Category:</span>
                                    <p class="text-sm font-bold text-purple-400">
                                        <%= book.category %>
                                    </p>
                                </div>

                                <!-- Card Footer -->
                                <div class="mt-auto pt-4 border-t border-white/10 flex items-center justify-between"
                                    style="margin-top: 10px;">
                                    <span class="text-xs text-gray-400 uppercase tracking-widest font-bold"
                                        style="margin-top: 10px;">Price:</span>
                                    <p
                                        class="text-xl font-black text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-cyan-400">
                                        $<%= book.price %>
                                    </p>
                                </div>

                                <!-- Action Buttons -->
                                <div class="flex items-center gap-4 pt-4 " style="margin-top: 10px; gap: 10px;">
                                    <a href="/edit/<%= book._id %>"
                                        class="flex-1 h-12 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center gap-2 text-cyan-400 hover:bg-cyan-400 hover:text-black hover:shadow-[0_0_15px_rgba(34,211,238,0.6)] transition-all duration-300 group/btn font-bold tracking-wider uppercase text-sm"
                                        title="Edit" style="padding: 5px 10px;">

                                        Edit
                                    </a>
                                    <a href="/delete/<%= book._id %>"
                                        class="flex-1 h-12 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center gap-2 text-pink-500 hover:bg-pink-500 hover:text-white hover:shadow-[0_0_15px_rgba(236,72,153,0.6)] transition-all duration-300 group/btn font-bold tracking-wider uppercase text-sm"
                                        title="Delete" style="padding: 5px 10px;">

                                        Delete
                                    </a>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                </div>
                <% } %>
    </main>
</body>
</html>