<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Book</title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800;900&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Outfit', sans-serif;
        }

        .bg-blob {
            position: absolute;
            filter: blur(100px);
            z-index: -1;
            opacity: 0.6;
            animation: float 10s infinite ease-in-out alternate;
        }

        @keyframes float {
            0% {
                transform: translate(0, 0) scale(1);
            }

            100% {
                transform: translate(30px, -50px) scale(1.2);
            }
        }
    </style>
</head>

<body
    class="min-h-screen bg-black text-white overflow-x-hidden selection:bg-cyan-500 selection:text-black relative z-0 flex items-center justify-center py-10">

    <!-- Background Blobs -->
    <div class="bg-blob w-[500px] h-[500px] bg-purple-600 rounded-full top-[-100px] left-[-100px]"></div>
    <div class="bg-blob w-[400px] h-[400px] bg-pink-600 rounded-full bottom-[10%] right-[-50px] animation-delay-2000">
    </div>
    <div
        class="bg-blob w-[600px] h-[600px] bg-blue-600 rounded-full top-[30%] left-[30%] opacity-30 animation-delay-4000">
    </div>

    <!-- Header / Navbar Minimal -->
    <header class="w-full absolute top-0 left-0 bg-black/30 backdrop-blur-2xl border-b border-white/10 z-50">
        <div class="max-w-7xl mx-auto px-6 py-5 flex items-center justify-between">
            <h1
                class="text-4xl font-black tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-fuchsia-500 to-purple-500 drop-shadow-[0_0_15px_rgba(236,72,153,0.5)]">
                NEXA<span class="text-white">BOOKS</span>
            </h1>
            <a href="/"
                class="text-gray-400 hover:text-white transition-colors font-bold uppercase tracking-wider text-sm">
                ← Back to Collection
            </a>
        </div>
    </header>

    <div class="max-w-6xl w-full px-6 flex flex-row flex-wrap items-center justify-center gap-12 relative z-10 mt-20 mb-20"
        style="gap: 20px;margin-top: 100px;">

        <!-- Left Side: Existing Card -->
        <div class="w-full max-w-xs shrink-0">

            <div
                class="group relative bg-white/10 backdrop-blur-xl border border-white/20 rounded-[2rem] overflow-hidden hover:shadow-[0_0_40px_rgba(236,72,153,0.3)] transition-all duration-500 flex flex-col" style="height: 600px;">

                <div
                    class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-pink-500/20 opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-0">
                </div>

                <div class="w-full aspect-[3/4] p-4 relative z-10" style="height: 380px;">
                    <div class="w-full rounded-2xl overflow-hidden relative shadow-2xl">
                        <div
                            class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent z-10 opacity-60 group-hover:opacity-20 transition-opacity duration-300">
                        </div>

                        <img src="../uploads/<%= book.img %>" alt="<%= book.name %>"
                            class="w-full  object-cover group-hover:scale-110 transition-transform duration-700 ease-out"
                            style="height: 450px;">

                        <div class="absolute top-3 left-3 z-20">
                            <span
                                class="px-3 py-1.5 text-[10px] font-black uppercase tracking-widest bg-cyan-400 text-black rounded-full shadow-[0_0_15px_rgba(34,211,238,0.6)]">
                                <%= book.category %>
                            </span>
                        </div>
                    </div>
                </div>

                <div class="px-6 pb-6 pt-4 flex flex-col relative z-20 space-y-2">
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-gray-400 uppercase tracking-widest font-bold">Book Name:</span>
                        <p
                            class="text-sm font-black text-white group-hover:text-cyan-300 transition-colors line-clamp-1">
                            <%= book.name %>
                        </p>
                    </div>

                    <div class="flex items-center justify-between">
                        <span class="text-xs text-gray-400 uppercase tracking-widest font-bold">Author:</span>
                        <p class="text-sm font-bold text-pink-400 truncate">
                            <%= book.author %>
                        </p>
                    </div>

                    <div class="flex items-center justify-between">
                        <span class="text-xs text-gray-400 uppercase tracking-widest font-bold">Category:</span>
                        <p class="text-sm font-bold text-purple-400">
                            <%= book.category %>
                        </p>
                    </div>

                    <div class="mt-auto pt-2 border-t border-white/10 flex items-center justify-between">
                        <span class="text-xs text-gray-400 uppercase tracking-widest font-bold">Price:</span>
                        <p
                            class="text-xl font-black text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-cyan-400">
                            $<%= book.price %>
                        </p>
                    </div>
                </div>

            </div>
        </div>

        <!-- Right Side: Form -->
        <form method="post" enctype="multipart/form-data"
            class="w-full max-w-md shrink-0 bg-white/10 backdrop-blur-xl border border-white/20 shadow-2xl rounded-3xl p-8">
            <h1
                class="text-4xl font-extrabold text-center text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-fuchsia-500 to-purple-500 mb-8 drop-shadow-lg">
                ✏️ Edit Book
            </h1>

            <div class="mb-5">
                <label for="name" class="block text-white font-semibold mb-2">Book Name</label>
                <input type="text" id="name" name="name" value="<%= book.name %>" placeholder="Enter Book Name"
                    class="w-full p-3 rounded-xl bg-white/10 border border-white/20 outline-none focus:border-cyan-400 text-white placeholder-gray-400 transition-colors">
            </div>

            <div class="mb-5">
                <label for="author" class="block text-white font-semibold mb-2">Author Name</label>
                <input type="text" id="author" name="author" value="<%= book.author %>" placeholder="Enter Author Name"
                    class="w-full p-3 rounded-xl bg-white/10 border border-white/20 outline-none focus:border-pink-400 text-white placeholder-gray-400 transition-colors">
            </div>

            <div class="mb-5">
                <label for="cat" class="block text-white font-semibold mb-2">Book Category</label>
                <input type="text" id="cat" name="cat" value="<%= book.category %>" placeholder="Enter Book Category"
                    class="w-full p-3 rounded-xl bg-white/10 border border-white/20 outline-none focus:border-purple-400 text-white placeholder-gray-400 transition-colors">
            </div>

            <div class="mb-5">
                <label for="price" class="block text-white font-semibold mb-2">Book Price</label>
                <input type="number" id="price" name="price" value="<%= book.price %>" placeholder="Enter Book Price"
                    class="w-full p-3 rounded-xl bg-white/10 border border-white/20 outline-none focus:border-green-400 text-white placeholder-gray-400 transition-colors">
            </div>

            <div class="mb-6">
                <label for="img" class="block text-white font-semibold mb-2">Upload New Image (Optional)</label>
                <input type="file" id="img" name="img"
                    class="w-full p-2 rounded-xl bg-white/10 border border-white/20 text-white file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-cyan-500 file:text-black hover:file:bg-cyan-400 transition-colors cursor-pointer">
            </div>

            <button type="submit"
                class="w-full py-3 rounded-xl bg-gradient-to-r from-cyan-500 to-purple-600 text-white font-bold shadow-[0_0_20px_rgba(34,211,238,0.4)] hover:scale-105 hover:shadow-[0_0_30px_rgba(236,72,153,0.6)] transition duration-300">
                Update Book
            </button>
        </form>

    </div>

</body>

</html>